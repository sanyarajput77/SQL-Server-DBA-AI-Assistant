{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://example.invalid/dba-ai-assistant/config.schema.json",
  "title": "DBA Automation Configuration",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "Environment",
    "EnvironmentId",
    "ApprovedInstances",
    "DefaultInstance",
    "TrustServerCertificate",
    "BackupDirectory",
    "ReportDirectory",
    "LogDirectory",
    "Thresholds",
    "Timeouts",
    "ApprovedDatabases",
    "ProtectedDatabases",
    "BackupPolicy"
  ],
  "properties": {
    "$schema": { "type": "string" },
    "Environment": { "enum": ["Development", "Test", "UAT", "Production", "Lab"] },
    "EnvironmentId": { "type": "string", "minLength": 1, "maxLength": 64, "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$" },
    "ApprovedInstances": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1, "maxLength": 256, "pattern": "^[A-Za-z0-9_.\\\\,:-]+$" }
    },
    "DefaultInstance": { "type": "string", "minLength": 1, "pattern": "\\S" },
    "TrustServerCertificate": { "type": "boolean" },
    "BackupDirectory": { "type": "string", "minLength": 1, "pattern": "\\S" },
    "ReportDirectory": { "type": "string", "minLength": 1, "pattern": "\\S" },
    "LogDirectory": { "type": "string", "minLength": 1, "pattern": "\\S" },
    "Thresholds": {
      "type": "object",
      "additionalProperties": false,
      "required": ["BackupWarningHours", "DiskWarningPercentFree", "LongRunningQuerySeconds", "FailedJobsHours"],
      "properties": {
        "BackupWarningHours": { "type": "integer", "minimum": 1, "maximum": 8760 },
        "DiskWarningPercentFree": { "type": "number", "exclusiveMinimum": 0, "maximum": 100 },
        "LongRunningQuerySeconds": { "type": "integer", "minimum": 1, "maximum": 86400 },
        "FailedJobsHours": { "type": "integer", "minimum": 1, "maximum": 720 }
      }
    },
    "Timeouts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["QueryTimeoutSeconds", "ConnectionTimeoutSeconds"],
      "properties": {
        "QueryTimeoutSeconds": { "type": "integer", "minimum": 1, "maximum": 86400 },
        "ConnectionTimeoutSeconds": { "type": "integer", "minimum": 1, "maximum": 3600 }
      }
    },
    "ApprovedDatabases": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1, "pattern": "\\S" }
    },
    "ProtectedDatabases": {
      "type": "array",
      "minItems": 4,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1, "pattern": "\\S" }
    },
    "BackupPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["Enabled", "AllowedTypes", "ApprovalRequired"],
      "properties": {
        "Enabled": { "type": "boolean" },
        "AllowedTypes": {
          "type": "array",
          "uniqueItems": true,
          "items": { "enum": ["Full", "Differential", "Log"] }
        },
        "ApprovalRequired": { "const": true }
      }
    }
  }
}
